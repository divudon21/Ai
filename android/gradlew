#!/bin/sh
# Gradle bootstrap script.
# Downloads Gradle 8.5 from services.gradle.org on first run, then delegates.
# This lets `flutter build apk` invoke Gradle without a preinstalled Gradle.
set -e

GRADLE_VERSION=8.0
GRADLE_DIR="${GRADLE_HOME:-/tmp/gradle-${GRADLE_VERSION}}"
GRADLE_BIN="$GRADLE_DIR/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  echo "Downloading Gradle ${GRADLE_VERSION} ..." >&2
  rm -rf /tmp/gradle-*
  mkdir -p "$GRADLE_DIR"
  curl -fsSL --retry 5 --retry-delay 5 \
    "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
    -o /tmp/gradle.zip
  unzip -q /tmp/gradle.zip -d /tmp
  rm -f /tmp/gradle.zip
  if [ ! -x "$GRADLE_BIN" ]; then
    echo "ERROR: Gradle ${GRADLE_VERSION} could not be installed." >&2
    exit 1
  fi
fi

exec "$GRADLE_BIN" "$@"
